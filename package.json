{
  "name": "unibo-qr",
  "version": "1.1.0",
  "description": "Self-contained, offline, bilingual (IT/EN) QR code generator \u2014 single HTML file, PNG/JPEG/WebP/SVG/PDF export.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.8"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "test": "npm run lint && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/qr-core.js\" --test-coverage-include=\"src/i18n.js\" --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 \"tests/unit/*.test.js\"",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:all": "node scripts/e2e.mjs chromium firefox webkit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "axe-core": "^4.14.1",
    "eslint": "9.39.5",
    "globals": "15.15.0",
    "jsqr": "^1.4.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gsamuele78/unibo-qr.git"
  },
  "keywords": [
    "qr-code",
    "offline",
    "single-file",
    "i18n",
    "unibo",
    "svg",
    "pdf"
  ]
}
